# Puerto en el que escucha el servidor Go, tanto dentro del contenedor "app"
# como publicado hacia el host (docker-compose.yml usa el mismo valor para
# ambos lados del mapeo de puertos).
APP_PORT=8080

# Ruta del archivo SQLite dentro del volumen nombrado "sqlite-data", montado
# en la misma ruta interna en "db" y en "app".
DB_PATH=/data/app.db
